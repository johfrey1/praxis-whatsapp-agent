# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024

# --- WhatsApp Cloud API (Meta) ---
# App > WhatsApp > API Setup en developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Token que tú inventas y pegas también en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_GRAPH_API_VERSION=v21.0

# Número(s) de asesor humano (formato E.164 sin '+', separados por coma) a los que se
# notifica cuando el agente escala una conversación o entra un contacto nuevo
STAFF_NOTIFICATION_NUMBERS=

# --- Base de datos propia del agente ---
DATABASE_URL=postgresql+asyncpg://whatsapp_agent:whatsapp_agent@whatsapp-agent-db:5432/whatsapp_agent

# --- Strapi (plataforma existente, solo lectura) ---
STRAPI_BASE_URL=http://strapi:1337
STRAPI_API_TOKEN=

# --- Wompi (pago de cuotas) ---
# dashboard de Wompi > Desarrolladores. Cada ambiente usa sus propias llaves:
# sandbox -> pub_test_/prv_test_/test_events_ ; production -> pub_prod_/prv_prod_/prod_events_
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Horas de vigencia del link de pago de un solo uso
WOMPI_PAYMENT_LINK_TTL_HOURS=24
# Opcional: a dónde redirigir al estudiante tras pagar
WOMPI_REDIRECT_URL=

# --- Admin API (subida de documentos / consulta de leads) ---
ADMIN_API_KEY=change-me

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCUMENT_STORAGE_PATH=/app/storage/documents
